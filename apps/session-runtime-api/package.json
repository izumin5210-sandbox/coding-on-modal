{
  "name": "session-runtime-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --external:@anthropic-ai/claude-agent-sdk --outfile=dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.27.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.22",
    "@hono/zod-validator": "^0.7.5",
    "@hono/node-server": "^1.19.9",
    "hono": "^4.12.0",
    "zod": "^4.3.6"
  }
}
